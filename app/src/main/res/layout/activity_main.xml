</HorizontalScrollView>



<!-- MENU BAR -->

<LinearLayout
android:layout_width="match_parent"
android:layout_height="65dp"
android:orientation="horizontal"
android:background="#20242B">


<Button
android:text="MAIN"/>

<Button
android:text="EQ"/>

<Button
android:text="CROSSOVER"/>

<Button
android:text="DELAY"/>

<Button
