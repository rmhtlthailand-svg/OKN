android:background="#141820">


<TextView
android:id="@+id/ch2Name"
android:text="CH2 FRONT R"
android:textColor="#FFFFFF"/>


<SeekBar
android:id="@+id/ch2Slider"
android:layout_width="250dp"
android:layout_height="50dp"
android:rotation="270"/>


<Button
android:id="@+id/ch2Mute"
android:text="MUTE"/>

</LinearLayout>




<!-- CH3 -->

<LinearLayout
android:layout_width="120dp"
